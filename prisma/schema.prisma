generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
  SOLD_OUT
}

enum RequestStatus {
  SUBMITTED
  REVIEWING
  QUOTATION
  WAITING_PAYMENT
  PAID
  IN_PROGRESS
  REVISION
  FINAL_REVIEW
  COMPLETED
  CANCELLED
  REJECTED
  ON_HOLD
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PricingType {
  FIXED
  STARTING_FROM
  CUSTOM_QUOTE
  CONTACT
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  DESIGNER
  ARTIST_3D
  SUPPORT
  PRODUCT_MANAGER
  CONTENT_MANAGER
}

model User {
  id            String            @id @default(cuid())
  name          String
  username      String            @unique
  email         String            @unique
  passwordHash  String
  role          StaffRole?
  googleId      String?           @unique
  locale        String            @default("id")
  theme         String            @default("system")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orders        Order[]
  requests      ServiceRequest[]
  reviews       Review[]
  wishlist      WishlistItem[]
  downloads     DownloadLog[]
  tickets       Ticket[]
  sessions      UserSession[]
  notifications Notification[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id            String        @id @default(cuid())
  productId     String        @unique
  name          String
  slug          String         @unique
  description   String
  category      String
  price         Int
  discount      Int           @default(0)
  salesCount    Int           @default(0)
  thumbnail     String?
  gallery       Json?
  filePath      String?
  version       String         @default("1.0.0")
  changelog     String?
  license       String?
  compatibility String?
  requirements  String?
  author        String?
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orderItems OrderItem[]
  wishlist   WishlistItem[]
  reviews    Review[]
  downloads  DownloadLog[]
  bundleItems BundleItem[]

  @@index([status, category])
  @@index([salesCount])
}

model ServiceRequest {
  id               String        @id @default(cuid())
  requestId        String        @unique
  customerId       String
  serviceType      String
  requestedProduct String?
  description      String
  size             String?
  format           String?
  deadline         DateTime?
  budget           Int?
  references       Json?
  notes            String?
  status           RequestStatus @default(SUBMITTED)
  quotedPrice      Int?
  revisionLimit    Int           @default(2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer   User         @relation(fields: [customerId], references: [id])
  quotations Quotation[]
  revisions  Revision[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Quotation {
  id            String   @id @default(cuid())
  requestId     String
  scope         String
  price         Int
  discount      Int      @default(0)
  extras        Int      @default(0)
  total         Int
  deadline      DateTime?
  revisionCount Int      @default(2)
  terms         String
  validUntil    DateTime
  approvedAt    DateTime?

  request ServiceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([validUntil])
}

model Order {
  id            String        @id @default(cuid())
  orderId       String        @unique
  customerId    String
  couponId      String?
  paymentMethod       String        @default("QRIS")
  gatewayProvider     String?
  gatewayToken        String?
  gatewayRedirectUrl  String?
  gatewayTransactionId String?
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  invoicePath   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      User           @relation(fields: [customerId], references: [id])
  coupon        Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  downloads     DownloadLog[]
  paymentEvents PaymentEvent[]

  @@index([customerId, createdAt])
  @@index([couponId])
  @@index([paymentStatus, status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  price     Int
  discount  Int    @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model DownloadLog {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  orderId      String?
  tokenHash    String   @unique
  expiresAt    DateTime
  count        Int      @default(0)
  maxDownloads Int?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([expiresAt])
}

model PaymentEvent {
  id          String        @id @default(cuid())
  eventId     String        @unique
  orderId     String?
  status      PaymentStatus
  amount      Int?
  payload     Json?
  processedAt DateTime      @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([processedAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([productId, approved])
}

model Revision {
  id             String   @id @default(cuid())
  requestId      String
  number         Int
  notes          String
  attachmentPath String?
  createdAt      DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Ticket {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  userId    String
  subject   String
  category  String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PortfolioEntry {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  description String
  image       String?
  services    Json?
  year        Int?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, createdAt])
  @@index([category])
}

model ProjectCaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  summary     String
  description String
  software    Json?
  services    Json?
  status      String   @default("COMPLETED")
  coverImage  String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  author      String
  tags        Json?
  published   Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([createdAt])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int?
  discountFixed   Int?
  minSubtotal     Int      @default(0)
  maxUses         Int?
  usedCount       Int      @default(0)
  active          Boolean  @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]

  @@index([active, startsAt, endsAt])
}

model Bundle {
  id              String       @id @default(cuid())
  bundleId        String       @unique
  slug            String       @unique
  name            String
  description     String
  discountPercent Int          @default(0)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items BundleItem[]

  @@index([active, createdAt])
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int     @default(1)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([bundleId, productId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
